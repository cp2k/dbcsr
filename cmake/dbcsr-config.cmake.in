@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Hints for locating DBCSR's dependencies (override with your own -D flags)
set(DBCSR_LIBXSROOT "@LIBXSROOT@")
set(DBCSR_LIBXSTREAMROOT "@LIBXSTREAMROOT@")
set(DBCSR_LIBXSMMROOT "@LIBXSMMROOT@")
set(DBCSR_LIBXS_DIR "@libxs_DIR@")
set(DBCSR_LIBXSTREAM_DIR "@libxstream_DIR@")
set(DBCSR_LIBXSMM_DIR "@libxsmm_DIR@")
set(DBCSR_OPENCL_INCDIR "@OPENCL_INCDIR@")
set(DBCSR_OPENCL_LIBDIR "@OPENCL_LIBDIR@")

# Make DBCSR's dependency locations discoverable
set(_dbcsr_prefix_path_save "${CMAKE_PREFIX_PATH}")
if (DBCSR_LIBXSROOT)
  list(PREPEND CMAKE_PREFIX_PATH "${DBCSR_LIBXSROOT}")
endif ()
if (DBCSR_LIBXSTREAMROOT)
  list(PREPEND CMAKE_PREFIX_PATH "${DBCSR_LIBXSTREAMROOT}")
endif ()
if (DBCSR_LIBXSMMROOT)
  list(PREPEND CMAKE_PREFIX_PATH "${DBCSR_LIBXSMMROOT}")
endif ()
# Package locations of DBCSR's build (e.g., lib/<target>/cmake/libxs) come first
if (NOT libxs_DIR AND EXISTS "${DBCSR_LIBXS_DIR}")
  set(libxs_DIR "${DBCSR_LIBXS_DIR}")
endif ()
if (NOT libxstream_DIR AND EXISTS "${DBCSR_LIBXSTREAM_DIR}")
  set(libxstream_DIR "${DBCSR_LIBXSTREAM_DIR}")
endif ()
if (NOT libxsmm_DIR AND EXISTS "${DBCSR_LIBXSMM_DIR}")
  set(libxsmm_DIR "${DBCSR_LIBXSMM_DIR}")
endif ()

set(DBCSR_USE_MPI @USE_MPI@)
if (@USE_MPI@)
  find_dependency(MPI)
endif ()

set(DBCSR_USE_OPENMP @USE_OPENMP@)
if (@USE_OPENMP@)
  find_dependency(OpenMP)
endif ()

set(DBCSR_USE_LIBXS @USE_LIBXS@)
if (@USE_LIBXS@)
  find_dependency(libxs CONFIG REQUIRED)
endif ()

set(DBCSR_USE_LIBXSMM @USE_LIBXSMM@)
if (@USE_LIBXSMM@)
  find_dependency(libxsmm CONFIG QUIET)
  if (NOT libxsmm_FOUND)
    find_dependency(PkgConfig)
    pkg_check_modules(DBCSR_LIBXSMM_PC QUIET IMPORTED_TARGET GLOBAL libxsmm)
    if (DBCSR_LIBXSMM_PC_FOUND AND NOT TARGET libxsmm::libxsmm)
      add_library(libxsmm::libxsmm ALIAS PkgConfig::DBCSR_LIBXSMM_PC)
    endif ()
  endif ()
endif ()

set(DBCSR_USE_ACCEL @USE_ACCEL@)
if ("@USE_ACCEL@" MATCHES "cuda")
  enable_language(CUDA)
  find_dependency(CUDAToolkit)
endif ()

if ("@USE_ACCEL@" MATCHES "hip")
  enable_language(HIP)
  find_dependency(hip)
  find_dependency(hipblas)
  find_dependency(hiprtc)
endif ()

if ("@USE_ACCEL@" MATCHES "opencl")
  set(_dbcsr_include_path_save "${CMAKE_INCLUDE_PATH}")
  set(_dbcsr_library_path_save "${CMAKE_LIBRARY_PATH}")
  # Where DBCSR's build found OpenCL, otherwise the same hints as the build
  if (EXISTS "${DBCSR_OPENCL_INCDIR}" AND EXISTS "${DBCSR_OPENCL_LIBDIR}")
    list(PREPEND CMAKE_INCLUDE_PATH "${DBCSR_OPENCL_INCDIR}")
    list(PREPEND CMAKE_LIBRARY_PATH "${DBCSR_OPENCL_LIBDIR}")
  else ()
    if (DEFINED ENV{CUDA_PATH})
      list(APPEND CMAKE_PREFIX_PATH "$ENV{CUDA_PATH}")
    else ()
      find_program(_dbcsr_nvcc nvcc NO_CACHE)
      if (_dbcsr_nvcc)
        get_filename_component(_dbcsr_cuda_root "${_dbcsr_nvcc}" REALPATH)
        cmake_path(GET _dbcsr_cuda_root PARENT_PATH _dbcsr_cuda_root)
        cmake_path(GET _dbcsr_cuda_root PARENT_PATH _dbcsr_cuda_root)
        list(APPEND CMAKE_PREFIX_PATH "${_dbcsr_cuda_root}")
        unset(_dbcsr_cuda_root)
      endif ()
      unset(_dbcsr_nvcc)
    endif ()
    if (DEFINED ENV{CMPLR_ROOT})
      list(APPEND CMAKE_PREFIX_PATH "$ENV{CMPLR_ROOT}")
      list(APPEND CMAKE_INCLUDE_PATH "$ENV{CMPLR_ROOT}/include/sycl")
    endif ()
  endif ()
  find_dependency(OpenCL)
  set(CMAKE_INCLUDE_PATH "${_dbcsr_include_path_save}")
  set(CMAKE_LIBRARY_PATH "${_dbcsr_library_path_save}")
  unset(_dbcsr_include_path_save)
  unset(_dbcsr_library_path_save)
  find_dependency(libxstream CONFIG QUIET)
  if (NOT libxstream_FOUND)
    find_dependency(PkgConfig)
    pkg_check_modules(DBCSR_LIBXSTREAM_PC QUIET IMPORTED_TARGET GLOBAL libxstream)
    if (DBCSR_LIBXSTREAM_PC_FOUND AND NOT TARGET libxstream::libxstream)
      add_library(libxstream::libxstream ALIAS PkgConfig::DBCSR_LIBXSTREAM_PC)
    endif ()
  endif ()
endif ()

set(CMAKE_PREFIX_PATH "${_dbcsr_prefix_path_save}")
unset(_dbcsr_prefix_path_save)

include("${CMAKE_CURRENT_LIST_DIR}/dbcsr-targets.cmake")
